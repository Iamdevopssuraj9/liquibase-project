<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Initial database schema creation -->
    <changeSet id="001-1" author="suraj">
        <createTable tableName="DEPARTMENT">
            <column name="ID" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="DEPT_NAME" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="LOCATION" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="CREATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="001-2" author="suraj">
        <createTable tableName="EMPLOYEE">
            <column name="ID" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="FIRST_NAME" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_NAME" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="EMAIL" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="DEPARTMENT_ID" type="INT">
                <constraints nullable="true" foreignKeyName="fk_employee_dept" 
                            references="DEPARTMENT(ID)"/>
            </column>
            <column name="SALARY" type="DECIMAL(10,2)">
                <constraints nullable="true"/>
            </column>
            <column name="HIRE_DATE" type="DATE"/>
            <column name="CREATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="001-3" author="suraj">
        <createIndex tableName="EMPLOYEE" indexName="idx_employee_email">
            <column name="EMAIL"/>
        </createIndex>
        
        <createIndex tableName="EMPLOYEE" indexName="idx_employee_dept">
            <column name="DEPARTMENT_ID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>